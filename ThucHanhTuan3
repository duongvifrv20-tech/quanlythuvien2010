import java.util.Locale;
import java.util.Scanner;

public class ThucHanhTuan3 {

    protected String maSach, tenSach, tacGia;
    protected int namXuatBan, soLuong;
    protected double donGia, thanhTien, phiVanChuyen, tongTien;

    protected static final double TI_LE_PHI = 0.05;

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        sc.useLocale(Locale.US);

        ThucHanhTuan3 sach = new ThucHanhTuan3();
        sach.nhap(sc);
        sach.hienThi();
        sach.tinhTien();
        sach.hienThiTien();

        sc.close();
    }

    // Bài 1: nhập
    protected void nhap(Scanner sc) {
        System.out.print("Nhập mã sách: ");
        maSach = sc.nextLine();

        System.out.print("Nhập tên sách: ");
        tenSach = sc.nextLine();

        System.out.print("Nhập tác giả: ");
        tacGia = sc.nextLine();

        System.out.print("Nhập năm xuất bản: ");
        namXuatBan = sc.nextInt();

        System.out.print("Nhập đơn giá: ");
        donGia = sc.nextDouble();

        System.out.print("Nhập số lượng: ");
        soLuong = sc.nextInt();
    }

    // Bài 1: hiển thị lại
    protected void hienThi() {
        System.out.println("\n===== THÔNG TIN SÁCH =====");
        System.out.println("Mã sách       : " + maSach);
        System.out.println("Tên sách      : " + tenSach);
        System.out.println("Tác giả       : " + tacGia);
        System.out.println("Năm xuất bản  : " + namXuatBan);
        System.out.printf("Đơn giá       : %,.0f VNĐ%n", donGia);
        System.out.println("Số lượng      : " + soLuong);
    }

    // Bài 2, 3, 4
    protected void tinhTien() {
        thanhTien = donGia * soLuong;
        phiVanChuyen = thanhTien * TI_LE_PHI;
        tongTien = thanhTien + phiVanChuyen;
    }

    protected void hienThiTien() {
        System.out.println("\n===== TÍNH TIỀN NHẬP KHO =====");
        System.out.printf("Thành tiền        : %,.0f VNĐ%n", thanhTien);
        System.out.printf("Phí vận chuyển 5%% : %,.0f VNĐ%n", phiVanChuyen);
        System.out.printf("Tổng tiền nhập    : %,.0f VNĐ%n", tongTien);
    }
}